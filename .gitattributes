# Auto detect text files and perform LF normalization
* text=auto

# PowerShell scripts (CRLF on Windows for best PowerShell compatibility)
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf

# Config and documentation files
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
